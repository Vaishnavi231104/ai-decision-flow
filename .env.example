# --- LLM -------------------------------------------------------------
# Leave OPENAI_API_KEY empty to run in clearly-labelled MOCK mode
# (a keyword matcher answers YES/NO so you can demo the pipeline offline).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Inngest ---------------------------------------------------------
# Force the SDK to talk to the local Inngest dev server (`pnpm inngest`).
INNGEST_DEV=1
# Where the dev server listens. Only change if you moved it.
INNGEST_BASE_URL=http://127.0.0.1:8288
# Production only (Inngest Cloud):
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
