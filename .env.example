# --- LLM -------------------------------------------------------------
# Copy this file to .env.local and put your real key there.
# NEVER put a real key in .env.example: this file is committed to git.
#
# Leave OPENAI_API_KEY empty to run in clearly-labelled MOCK mode
# (a keyword matcher answers YES/NO so you can demo the pipeline offline).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: use any OpenAI-compatible provider instead of OpenAI.
# Free option, Groq (key from https://console.groq.com/keys). Set all three:
#   OPENAI_API_KEY=gsk_your_key_here
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-20b
# Remember to keep only ONE OPENAI_MODEL line in .env.local; the last one wins.
OPENAI_BASE_URL=

# --- Inngest ---------------------------------------------------------
# Force the SDK to talk to the local Inngest dev server (`pnpm inngest`).
INNGEST_DEV=1
# Where the dev server listens. Only change if you moved it.
INNGEST_BASE_URL=http://127.0.0.1:8288
# Production only (Inngest Cloud):
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
